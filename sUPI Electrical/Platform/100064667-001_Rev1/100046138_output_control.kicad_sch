	(text "DATA SIGNAL (USB AND GPIO) ENABLE SEQUENCE:\n  1. ENABLE LINE ASSERTED VIA MICROCONTROLLER OR SOLDER BRIDGE\n  2. LOAD SWITCH ENERGIZES OUTPUT AFTER PROGRAMMED DELAY\n  3. POWER-ON RESET ADDS FURTHER DELAY, THEN ENABLES DATA SWITCHES\nDATA SWITCHES ARE DISABLED IMMEDIATELY IF ANY OF THE FOLLOWING ARE TRUE:\n  1. ENABLE LINE IS DE-ASSERTED\n  2. LOAD SWITCH POWER GOOD IS DE-ASSERTED\n  3. 3.3V RAIL FALLS BELOW POWER-ON RESET THRESHOLD"
		(exclude_from_sim no)
		(at 24.638 175.006 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left bottom)
		)
		(uuid "0ddc37d3-dd34-423f-b45b-39787c367b15")
	)
	(text "PLACE JP2 AND JP3 TOGETHER.\n\nPLACE SILKSCREEN NEAR JP2:\n\"DETECT PAYLOAD\"\n\nPLACE SILKSCREEN NEAR JP3:\n\"FORCE ON\"\n\nPLACE SILKSCREEN BETWEEN JP2 AND JP3:\n\"SELECT\""
		(exclude_from_sim no)
		(at 21.59 48.514 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left bottom)
		)
		(uuid "130588d9-3f73-455f-8c4c-dc56785dc2d4")
	)
	(text "3"
		(exclude_from_sim no)
		(at 399.542 335.026 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left bottom)
		)
		(uuid "181bd78c-e7b2-45fd-bea5-c8b8b1b1b082")
	)
	(text "RESISTORS IN SERIES WITH THE JUMPERS ARE TO PREVENT\nDAMAGE TO MICROCONTROLLER IF BOTH JUMPERS ARE BRIDGED\nAT ONCE.  ONLY ONE JUMPER IS MEANT TO BE BRIDGED AT A TIME."
		(exclude_from_sim no)
		(at 25.4 130.302 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left bottom)
		)
		(uuid "1a995c95-347d-4dac-9032-49f9670d0f3e")
	)
