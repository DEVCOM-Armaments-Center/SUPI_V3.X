	)
	(text "RC ON ENABLE SERVES TWO PURPOSES:\n  1. EXTEND LOAD SWITCH OUTPUT DISCHARGE TIME.  ACTIVE DISCHARGE\n     ONLY OCCURS WHEN ENABLE LINE IS WITHIN 0.6-1.8V WINDOW.\n  2. PREVENT DAMAGING RINGING DUE TO LARGE INPUT CAPACITANCE"
		(exclude_from_sim no)
		(at 25.146 146.05 0)
