    (net (code "1") (name "/Block Diagram/AUX1")
      (node (ref "J3") (pin "1") (pintype "bidirectional"))
      (node (ref "R6") (pin "1") (pintype "passive"))
      (node (ref "U6") (pin "1") (pinfunction "K1") (pintype "passive")))
    (net (code "2") (name "/Block Diagram/AUX2")
      (node (ref "J4") (pin "1") (pintype "bidirectional"))
      (node (ref "R5") (pin "1") (pintype "passive"))
      (node (ref "U6") (pin "2") (pinfunction "K2") (pintype "passive")))
    (net (code "3") (name "/Block Diagram/Data Switches/DATA_ENABLE")
      (node (ref "U11") (pin "4") (pinfunction "VCC") (pintype "power_in"))
      (node (ref "U12") (pin "4") (pintype "output")))
    (net (code "4") (name "/Block Diagram/Data Switches/GPIO_DOWN_0")
      (node (ref "J10") (pin "4") (pinfunction "4") (pintype "input"))
      (node (ref "U10") (pin "2") (pinfunction "COM1") (pintype "bidirectional")))
    (net (code "5") (name "/Block Diagram/Data Switches/GPIO_DOWN_1")
      (node (ref "J10") (pin "5") (pinfunction "5") (pintype "input"))
      (node (ref "U10") (pin "1") (pinfunction "COM2") (pintype "bidirectional")))
    (net (code "6") (name "/Block Diagram/Data Switches/P3V3")
      (node (ref "C27") (pin "2") (pintype "passive"))
      (node (ref "C28") (pin "1") (pintype "passive"))
